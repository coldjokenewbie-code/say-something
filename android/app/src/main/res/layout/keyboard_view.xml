<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#12100E"
    android:padding="8dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:textColor="#9C9489"
        android:textSize="13sp"
        android:text="按麥克風開始說話" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mode_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/key_switch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_bg"
            android:textColor="#ECE6DC"
            android:textSize="16sp"
            android:text="🌐" />

        <Button
            android:id="@+id/key_space"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="3"
            android:layout_margin="3dp"
            android:background="@drawable/key_bg"
            android:textColor="#ECE6DC"
            android:textAllCaps="false"
            android:text="空白" />

        <Button
            android:id="@+id/key_backspace"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_bg"
            android:textColor="#ECE6DC"
            android:textSize="18sp"
            android:text="⌫" />

        <Button
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/key_bg"
            android:textColor="#ECE6DC"
            android:textSize="18sp"
            android:text="↵" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mic_btn"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/mic_bg"
        android:src="@drawable/ic_mic"
        android:scaleType="centerInside"
        android:contentDescription="麥克風" />
</LinearLayout>
